{
  "name": "asistenq-tiktok",
  "version": "1.2.3",
  "description": "A minimal application but lot of feature for monitor the Tiktok Shop accounts in one app and bundled with additional tool (ziqva.com)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "bun tsc --emitDecoratorMetadata --downlevelIteration && xcopy src\\images dist\\images /s /e /h /y /i && xcopy src\\controller\\frontend dist\\controller\\frontend /s /e /h /y /i && xcopy src\\sounds dist\\sounds /s /e /h /y /i",
    "watch": "tsc -w",
    "build:mac": "bun tsc --emitDecoratorMetadata --downlevelIteration && cp -R src/images dist/images && cp -R src/controller/frontend dist/controller/frontend && cp -R src/sounds dist/sounds",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "start": "npm run build && npx electron ./dist/index.js",
    "start:mac": "npm run build:mac && npx electron ./dist/index.js",
    "start:prod": "npm run build:prod && npx electron ./dist/index.js",
    "clean:output": "npx rimraf electron/output",
    "package": "npm run clean:output && npm run build:prod && xcopy /y package.json dist && npx electron-builder",
    "package:mac": "npm run clean:output && npm run build:prod:mac && cp package.json dist && npx electron-builder",
    "build:prod": "npm run build && ts-node ./minifyProd.ts",
    "build:prod:mac": "npm run build:mac && ts-node ./minifyProd.ts",
    "publish": "npm run build:prod && xcopy /y package.json dist && npx electron-builder -p always"
  },
  "build": {
    "appId": "com.ziqvalabs.asistenq-tiktok",
    "productName": "AsistenQ Tiktok",
    "copyright": "Copyright © 2023 Ziqva Labs",
    "compression": "maximum",
    "directories": {
      "output": "electron/output"
    },
    "npmRebuild": false,
    "asar": true,
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "./dist/images/icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "fiko942",
          "repo": "asistenq-updater",
          "token": "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"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "./dist/images/icon.icns",
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*.dll",
      "!node_modules/**/*.exe",
      "!node_modules/**/{test,tests,__tests__}/**",
      "!**/*.spec.js",
      "!**/*.test.js",
      "!**/*.md",
      "!**/*.markdown",
      "!**/*.map",
      "!node_modules/@types/**/*",
      "!node_modules/electron",
      "!node_modules/eslint",
      "!node_modules/typescript",
      "!node_modules/uglify-js",
      "!node_modules/typescript-eslint",
      "!**/*.d.ts",
      "!.vscode/**/*",
      "!src",
      "!**/*.ts",
      "!**/*.md",
      "!**/*.log",
      "!**/*.txt",
      "!node_modules/puppeteer/.local_chromium",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      "dist/sounds",
      {
        "from": "node_modules/regedit/vbs",
        "to": "regedit/vbs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": null
  },
  "repository": "https://github.com/electron/electron-quick-start-typescript",
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo",
    "typescript"
  ],
  "author": "Ziqva Labs",
  "license": "CC0-1.0",
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/adm-zip": "^0.5.5",
    "@types/async-retry": "^1.4.8",
    "@types/axios": "^0.14.0",
    "@types/body-parser": "^1.19.5",
    "@types/cli-progress": "^3.11.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.16",
    "@types/device-uuid": "^1.0.3",
    "@types/electron": "latest",
    "@types/exceljs": "^1.3.0",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/html-to-text": "^9.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/moment": "^2.13.0",
    "@types/multer": "^1.4.10",
    "@types/node-fetch": "^2.6.9",
    "@types/otplib": "^10.0.0",
    "@types/ping": "^0.4.4",
    "@types/pump": "^1.1.3",
    "@types/puppeteer": "^7.0.4",
    "@types/query-string": "^6.3.0",
    "@types/selenium-webdriver": "^4.1.23",
