{
  "name": "asistenq",
  "version": "1.9.77-alpha",
  "description": "A minimal application but lot of feature for monitor the Tokopedia accounts in one app and bundled with additional tool (ziqva.com)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "bun tsc --emitDecoratorMetadata --downlevelIteration && xcopy src\\images dist\\images /s /e /h /y && xcopy src\\controller\\frontend dist\\controller\\frontend /s /e /h /y && xcopy src\\sounds dist\\sounds /s /e /h /y",
    "watch": "tsc -w",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "start": "npm run build && npx electron ./dist/index.js",
    "start:prod": "npm run build:prod && npx electron ./dist/index.js",
    "package": "npm run build:prod && xcopy /y package.json dist && npx electron-builder",
    "build:prod": "npm run build && ts-node ./minifyProd.ts",
    "publish": "npm run build:prod && xcopy /y package.json dist && npx electron-builder -p always"
  },
  "build": {
    "appId": "com.ziqvalabs.asistenq",
    "productName": "AsistenQ",
    "copyright": "Copyright © 2023 Ziqva Labs",
    "compression": "maximum",
    "directories": {
      "output": "electron/output"
    },
    "npmRebuild": "false",
    "asar": true,
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "./dist/images/icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "fiko942",
          "repo": "asistenq-updater",
          "token": "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"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*.dll",
      "!node_modules/**/*.exe",
      "!node_modules/**/{test,tests,__tests__}/**",
      "!**/*.spec.js",
      "!**/*.test.js",
      "!**/*.md",
      "!**/*.markdown",
      "!**/*.map",
      "!node_modules/@types/**/*",
      "!node_modules/electron",
      "!node_modules/eslint",
      "!node_modules/typescript",
      "!node_modules/uglify-js",
      "!node_modules/typescript-eslint",
      "!**/*.d.ts",
      "!.vscode/**/*",
      "!src",
      "!**/*.ts",
      "!**/*.md",
      "!**/*.log",
      "!**/*.txt",
      "!node_modules/puppeteer/.local_chromium",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      "dist/sounds",
      {
        "from": "node_modules/regedit/vbs",
        "to": "regedit/vbs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": null
  },
  "repository": "https://github.com/electron/electron-quick-start-typescript",
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo",
    "typescript"
  ],
  "author": "Ziqva Labs",
  "license": "CC0-1.0",
